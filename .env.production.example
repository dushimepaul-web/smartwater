# ===================== SmartWater IoT – production =====================
# 1) cp .env.production.example .env      2) remplacez TOUTES les valeurs « A_CHANGER »
# Générer un secret :  openssl rand -hex 32

# --- Domaine (sans https://) et e-mail pour le certificat HTTPS
DOMAINE=smartwater.mondomaine.com
EMAIL_LETSENCRYPT=admin@mondomaine.com

# --- Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=A_CHANGER_openssl_rand_hex_32
DJANGO_ALLOWED_HOSTS=smartwater.mondomaine.com,www.smartwater.mondomaine.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://smartwater.mondomaine.com,https://www.smartwater.mondomaine.com
DJANGO_TIME_ZONE=Africa/Bujumbura
SITE_URL=https://smartwater.mondomaine.com

# --- MySQL (conteneur « db »)
DB_NAME=smartwater
DB_USER=smartwater
DB_PASSWORD=A_CHANGER_mot_de_passe_mysql
MYSQL_ROOT_PASSWORD=A_CHANGER_mot_de_passe_root_mysql

# --- MQTT (conteneur « mqtt ») : identifiant que les ESP32 utiliseront
MQTT_USER=esp32
MQTT_PASSWORD=A_CHANGER_mot_de_passe_mqtt
MQTT_TOPIC_PREFIXE=smartwater/capteurs

# --- Divers
CAPTEUR_DELAI_HORS_LIGNE=60
NTFY_SERVEUR=https://ntfy.sh
# Les e-mails (Gmail) se configurent dans l'application : Paramètres > E-mail (SMTP)
