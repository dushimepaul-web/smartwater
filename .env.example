# Copiez ce fichier en .env et adaptez les valeurs.
DJANGO_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_TIME_ZONE=Africa/Bujumbura

# MySQL (WAMP/XAMPP par défaut : root sans mot de passe)
DB_NAME=smartwater
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Essai rapide sans MySQL : décommentez
# DB_ENGINE=sqlite

# Capteur hors ligne après X secondes sans mesure
CAPTEUR_DELAI_HORS_LIGNE=60

# Adresse du site (liens dans les e-mails et notifications)
SITE_URL=http://127.0.0.1:8000

# --- E-mails : configurez-les de préférence dans l'application (Paramètres > E-mail (SMTP)).
# Les lignes ci-dessous ne servent que si rien n'y est configuré.
# 1) Activez la validation en 2 étapes : https://myaccount.google.com/security
# 2) Créez un mot de passe d'application : https://myaccount.google.com/apppasswords
# 3) Collez les 16 lettres SANS espaces dans EMAIL_PASSWORD
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=votre.adresse@gmail.com
EMAIL_PASSWORD=
# DEFAULT_FROM_EMAIL=SmartWater IoT <votre.adresse@gmail.com>

# --- Notifications sur téléphone (application gratuite ntfy)
NTFY_SERVEUR=https://ntfy.sh
NTFY_TOKEN=

# Broker MQTT (python manage.py mqtt_listener)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=False
MQTT_TOPIC_PREFIXE=smartwater/capteurs
